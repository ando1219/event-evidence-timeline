# 复制为 .env 或在部署平台填写环境变量；不要把真实密钥提交到仓库

# 扶摇（同花顺金融数据 API）：行情、交易日历、标的检索。在 https://fuyao.aicubes.cn/admin 签发
FUYAO_API_KEY=
FUYAO_BASE_URL=https://fuyao.aicubes.cn

# OpenAI 兼容的大模型接口（DeepSeek / 通义 / Kimi 等）。不填则导入时使用规则抽取
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# iFinD MCP（新闻来源）。先填 URL 和凭证，访问 /api/ifind/tools 查看工具名，再填 IFIND_NEWS_TOOL
IFIND_MCP_URL=
IFIND_MCP_TOKEN=
IFIND_MCP_AUTH_HEADER=Authorization
IFIND_NEWS_TOOL=

# 可选
HTTP_TIMEOUT=12
# 运行中导入的数据落盘位置；留空则只存内存
RUNTIME_DATA_FILE=data/runtime.json
# 固定"当前时间"（演示/测试用），如 2026-10-14T12:00:00+08:00；留空为真实时间
DEMO_NOW=
